{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/keep-going.ts\" check",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/keep-going.ts\" watch",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
